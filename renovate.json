{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "schedule": ["* * 1,15 * *"],
  "baseBranchPatterns": ["main", "release/v1_10_x"],
  "ignorePresets": ["group:goOpenapi"],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "labels": ["release-notes/dependencies"],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchBaseBranches": ["release/v1_10_x"],
      "matchUpdateTypes": ["major", "minor", "pin", "replacement", "rollback", "bump"],
      "enabled": false
    },
    {
      "matchBaseBranches": ["release/v1_10_x"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "release/v1_10_x dependencies"
    },
    {
      "groupName": "crossplane and upjet",
      "matchPackageNames": [
        "github.com/crossplane/**",
        "github.com/crossplane-contrib/**"
      ]
    },
    {
      "groupName": "crossplane and upjet",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["crossplane"]
    },
    {
      "groupName": "kubernetes",
      "groupSlug": "kubernetes",
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/**"
      ]
    },
    {
      "groupName": "golang.org/x",
      "matchPackageNames": ["golang.org/x/**"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/(^|/)Dockerfile$/",
        "/(^|/)config.yml$/"
      ],
      "matchStrings": [
        "(export|ARG|--build-arg=) *TERRAFORM_PROVIDER_VERSION *[:|\\?]?= *(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "terraform-provider",
      "versioningTemplate": "hashicorp",
      "depNameTemplate": "SAP/btp"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/e2e_test\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=helm depName=crossplane registryUrl=https://charts\\.crossplane\\.io/stable\\s*\\n\\s*CROSSPLANE_CHART_VERSION:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?(?:\\s*\\n[^\\n]*)*?\\s*\\n\\s*CROSSPLANE_CHART_SHA256:\\s*['\"]?(?<currentDigest>[a-f0-9]{64})['\"]?"
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "crossplane",
      "registryUrlTemplate": "https://charts.crossplane.io/stable"
    }
  ]
}
